{
  "name": "Peek \u2014 photo comparison",
  "short_name": "Peek",
  "description": "Compare near-identical photos at pixel level. Each frame keeps its own zoom and position.",
  "start_url": ".",
  "scope": ".",
  "display": "standalone",
  "display_override": [
    "standalone"
  ],
  "orientation": "any",
  "background_color": "#14181D",
  "theme_color": "#14181D",
  "categories": [
    "photo",
    "productivity",
    "utilities"
  ],
  "icons": [
    {
      "src": "icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "share_target": {
    "action": "share-target/",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "files": [
        {
          "name": "images",
          "accept": [
            "image/jpeg",
            "image/png",
            "image/webp",
            "image/avif",
            "image/*"
          ]
        }
      ]
    }
  },
  "file_handlers": [
    {
      "action": ".",
      "accept": {
        "image/jpeg": [
          ".jpg",
          ".jpeg"
        ],
        "image/png": [
          ".png"
        ],
        "image/webp": [
          ".webp"
        ]
      }
    }
  ]
}